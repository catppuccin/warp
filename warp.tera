---
accent: rosewater
whiskers:
  version: "^2.10.0"
  matrix:
    - flavor
  filename: "themes/catppuccin_{{ flavor.identifier }}.yml"
---
background: '#{{ base.hex }}'
accent: '#{{ flavor.colors[accent].hex }}'
foreground: '#{{ text.hex }}'
details: {{ if(cond=flavor.dark, t="darker", f="lighter") }}
terminal_colors:
  normal:
  {%- for _, pair in flavor.ansi_color_pairs %}
    {{ pair.identifier }}: '#{{ pair.normal.hex }}'
  {%- endfor %}
  bright:
  {%- for _, pair in flavor.ansi_color_pairs %}
    {{ pair.identifier }}: '#{{ pair.bright.hex }}'
  {%- endfor %}
